# Prisma database URL — SQLite for local dev (file path relative to project root).
# For Supabase/PostgreSQL, switch provider in prisma/schema.prisma and use:
#   DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# HMAC-SHA256 secret used to sign session cookies (AUTH_SECRET).
# Generate a strong random value, e.g. `openssl rand -hex 32`.
# IMPORTANT: never reuse the value committed in .env.example in production.
AUTH_SECRET="replace-me-with-a-strong-random-string-min-32-chars"

# (Optional) Override the default doctor password used by `npm run db:seed`.
# SEED_DOCTOR_PASSWORD="YourStrongPassword@2024"
